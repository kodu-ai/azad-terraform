# The variables `cloudflare.ts setup --root cloudsql` writes, as JSON, to
# <instance>/terraform/cloudsql/terraform.tfvars.json. Edit that file rather
# than copying this one; INPUTS.md describes every field. Example values only.
gcp = {
  project_id = "customer-project-id"
  # Setup does not write a region; without one Cloud SQL goes to me-central2.
  region = "europe-west1"
  # Setup fills these with Cloudflare's published IPv4 ranges (Hyperdrive) and
  # the public IPv4 of the machine that runs apply (migrations).
  authorized_networks = {
    cloudflare-1 = "192.0.2.0/24"
    runner       = "198.51.100.10/32"
  }
}
cloudflare = {
  account_id = "00000000000000000000000000000000"
  api_origin = "https://api.board.example.com"
  web_origin = "https://board.example.com"
}
deployment = {
  revision        = "0000000000000000000000000000000000000000" # the source checkout's HEAD
  env_file        = "/home/you/.azad/instances/default/.env"
  state_directory = "/home/you/.azad/instances/default/terraform/cloudsql/installer-state"
}
host_zones = {
  "board.example.com"     = "11111111111111111111111111111111"
  "api.board.example.com" = "11111111111111111111111111111111"
}
