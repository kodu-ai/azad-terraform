# Only the existing external application credentials belong here.
# Copy to the instance directory's .env (outside this repository), replace these
# values, and pass its path to cloudflare.ts setup as --credentials.
CLOUDFLARE_API_TOKEN=replace-me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
GITHUB_APP_ID=12345
GITHUB_APP_CLIENT_SECRET=replace-me
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
# Optional: preserve an already configured GitHub webhook secret. If omitted,
# setup generates it; copy the generated private value into GitHub App settings.
# GITHUB_WEBHOOK_SECRET=

# Before the GitHub App exists: deploy with placeholder GITHUB_APP_* values
# (also GITHUB_APP_SLUG and GITHUB_APP_CLIENT_ID). GitHub features stay off and
# every install reports PENDING until the real App's values replace them.
# AZAD_SELF_HOST_GITHUB_APP_PENDING=1

# Your own S3-compatible bucket instead of this installation's R2 buckets.
# Files and Agent Connect releases share it unless STORAGE_RELEASES_BUCKET is set.
# STORAGE_ADAPTER=gcs            # or s3 (Amazon S3, R2, MinIO: also set STORAGE_REGION, STORAGE_ENDPOINT)
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=         # GCS: HMAC key of a service account with Storage Object Admin on the bucket
# STORAGE_SECRET_ACCESS_KEY=

# Existing Postgres only (including Neon): direct schema-owner DSN with TLS.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Full product runtime capabilities (otherwise setup reports these unconfigured):
# V3_CF_API_TOKEN=
# CLOUDFLARE_ARTIFACTS_API_TOKEN=
# CLOUDFLARE_ARTIFACTS_EVENTS_API_TOKEN=
# V3_CF_ARTIFACTS_NAMESPACE=   # default: this installation's own <resource prefix>-control
# V3_CONTROL_BACKUP_GITHUB_REPO=your-org/private-control-backup
# Account and event queue IDs are derived; never paste another instance's queue.

# For direct Neon with sslmode=verify-full, Terraform can register the
# OS-trusted public CA automatically (omit an existing CA ID when using this):
# AZAD_SELF_HOST_DATABASE_CA=neon-isrg-root-x1
# Otherwise, sslmode=verify-full needs an existing public CA certificate
# uploaded to this Cloudflare account. Non-secret; not a client certificate/key.
# The direct runner must also trust the database's public certificate chain.
# AZAD_SELF_HOST_DATABASE_CA_CERT_ID=
